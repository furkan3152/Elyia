{
  "name": "@elyia/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Elyia on-chain layer for Elysium: ElyiaRouter, ElyAccount + factory, ElyOrders. Not audited.",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "node scripts/test-all.cjs",
    "test:unit": "hardhat test test/unit.router.test.cjs test/unit.account.test.cjs test/unit.orders.test.cjs test/unit.export.test.cjs",
    "test:fork": "ELYIA_FORK=1 hardhat test test/fork.venues.test.cjs",
    "gas": "node scripts/gas-report.cjs",
    "export": "hardhat compile --quiet && node scripts/export.cjs",
    "coverage": "ELYIA_COVERAGE=1 hardhat coverage --testfiles \"test/unit.*.test.cjs\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "2.3.0",
    "solidity-coverage": "0.8.16"
  }
}
