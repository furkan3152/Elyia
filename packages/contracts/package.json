{
  "name": "@elyia/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Elyia on-chain layer for Elysium: ElyiaRouter, ElyAccount + factory, ElyOrders. Not audited.",
  "license": "MIT",
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit.*.test.cjs",
    "test:fork": "hardhat test test/fork.*.test.cjs",
    "gas": "REPORT_GAS=1 hardhat test",
    "export": "hardhat compile && node scripts/export.cjs",
    "manifest": "node scripts/export.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@openzeppelin/contracts": "5.6.1",
    "chai": "4.5.0",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "2.3.0"
  }
}
