{
  "name": "@elyia/sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the Elyia API: plan, prepare and submit intents, journey streams, venues, protocols, portfolio, Shield, Ely and webhook verification. Never signs: your wallet does.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "!dist/**/*.map", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@elyia/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
