# Elyia API environment. Copy to apps/api/.env for local development.
# Everything is optional: without keys the API serves read-only data in testnet mode.

# --- Server ---------------------------------------------------------------
PORT=3001
# HOST=0.0.0.0
# development | test | production (production drops the localhost CORS origins)
# NODE_ENV=development
# debug | info | warn | error | silent (default: debug in development, info in production)
# ELYIA_LOG_LEVEL=info
# Reverse-proxy hops in front of the API (per-IP rate limits key on the client address). Render: 1.
# ELYIA_TRUST_PROXY=0

# --- Product --------------------------------------------------------------
# testnet (default) | mainnet. Testnet and mainnet money never share an intent.
ELYIA_MODE=testnet
# Extra exact web origins allowed by CORS, comma-separated (http://localhost:5173 and :5174 are always allowed outside production).
# ELYIA_WEB_ORIGIN=https://elyia.example.com

# --- Storage --------------------------------------------------------------
# Postgres for durable state (tables are created on first use). Without it, an in-memory store is used.
# ELYIA_DATABASE_URL=postgresql://elyia:elyia@localhost:5432/elyia

# --- Sessions -------------------------------------------------------------
# At least 32 characters; signs Elyia-Session tokens (sign-in stays disabled without it).
# ELYIA_SESSION_SECRET=

# --- Telegram -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# 16-256 characters of A-Z a-z 0-9 _ - (sent by Telegram as X-Telegram-Bot-Api-Secret-Token)
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=

# --- Elysium Agent --------------------------------------------------------
# Enables AI tool use for the agent; without it the deterministic intent engine answers.
# ANTHROPIC_API_KEY=
# ELYIA_AGENT_MODEL=claude-sonnet-5-5

# --- RPC overrides --------------------------------------------------------
# Comma-separated http(s) URLs, tried before the public endpoints of the network registry.
# Keyed URLs are fine: only scheme://host is ever reported by /v1/health.
# ELYSIUM_TESTNET_RPC_URL=
# Elysium mainnet has no public RPC before launch; set this to enable it.
# ELYSIUM_MAINNET_RPC_URL=
# HYPEREVM_TESTNET_RPC_URL=
# HYPEREVM_MAINNET_RPC_URL=
# HYPERDEXER_API_KEY=

# --- Limits ---------------------------------------------------------------
# Hyperliquid REST weight this process may spend per minute per HyperCore network (HL allows ~1200 per IP).
# ELYIA_HL_WEIGHT_PER_MIN=900
# Requests per minute per IP: every /v1 route / expensive routes / sign-in routes.
# ELYIA_RATE_LIMIT_DEFAULT=600
# ELYIA_RATE_LIMIT_HEAVY=60
# ELYIA_RATE_LIMIT_AUTH=20

# --- Build identity (set by the host) -------------------------------------
# ELYIA_BUILD_COMMIT=
